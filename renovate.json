{
  "extends": [
    "config:js-lib",
    ":rebaseStalePrs",
    ":automergeAll",
    ":label(internal)",
    ":dependencyDashboard",
    ":enableVulnerabilityAlerts"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "minimumReleaseAge": null
  },
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchDepTypes": [
        "dependencies"
      ],
      "rangeStrategy": "bump"
    },
    {
      "matchPackageNames": [
        "execa"
      ],
      "allowedVersions": "< 6.0.0"
    },
    {
      "matchPackageNames": [
        "git-remote-origin-url"
      ],
      "allowedVersions": "< 4.0.0"
    }
  ]
}
